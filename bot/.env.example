# ─────────────────────────────────────────────────────────────────────────
# Конфигурация Telegram-бота мониторинга. Скопируй в .env и заполни:
#   cp bot/.env.example bot/.env
# Файл .env в git НЕ коммитим (см. .gitignore в корне).
# Как получить токен и chat_id — в bot/README.md.
# ─────────────────────────────────────────────────────────────────────────

# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather (вида 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# [ОБЯЗАТЕЛЬНО] Твой личный chat_id (число). Это whitelist: бот выполняет
# команды ТОЛЬКО от этого chat_id. Узнать свой id — через @userinfobot
# или командой из README.
TELEGRAM_CHAT_ID=

# [опционально] Адрес Docker Engine API. По умолчанию — смонтированный сокет.
# Менять обычно не нужно.
# DOCKER_HOST=unix:///var/run/docker.sock

# [опционально] Адрес, на котором бот принимает вебхуки от Alertmanager.
# Только внутри docker-сети, наружу не публикуется.
# WEBHOOK_LISTEN_ADDR=:9095

# [опционально] База Prometheus HTTP API для /status и /top.
# PROMETHEUS_URL=http://prometheus:9090

# [опционально] SOCKS5-прокси для доступа к Telegram API там, где он заблокирован
# (РФ). Пусто = прямое подключение. Обычно задаётся в docker-compose.yml (через
# host.docker.internal на локальный xray-прокси хоста), а не здесь.
# TELEGRAM_PROXY_URL=socks5://host.docker.internal:10808

# [опционально] Уровень логов: debug | info | warn | error (по умолчанию info).
# LOG_LEVEL=info
